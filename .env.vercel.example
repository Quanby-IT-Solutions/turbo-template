# Environment Variables for Vercel Deployment
# Copy these to Vercel Dashboard → Project Settings → Environment Variables

# Database Configuration
POSTGRES_URL=postgresql://user:password@host:5432/database

# Better Auth Configuration (Backend & Frontend)
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://your-app-name.vercel.app

# Better Auth Public URL (Client-side)
NEXT_PUBLIC_BETTER_AUTH_URL=https://your-app-name.vercel.app

# Optional: Backend API URL (if deployed separately)
# NEXT_PUBLIC_API_URL=https://your-backend-api.railway.app

# Optional: Node Environment
# NODE_ENV=production

# Instructions:
# 1. Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
# 2. Replace your-app-name with your actual Vercel app name
# 3. Update POSTGRES_URL with your database connection string
# 4. Add these to Vercel Dashboard, not to .env files in the repository
