# ==========================================================
# BACKEND API ENVIRONMENT VARIABLES
# ==========================================================

# Server Configuration
NODE_ENV=development
PORT=3000
# Includes the single-port Nginx proxy origin (http://localhost) plus raw
# ports for non-Docker local dev. In production this is just your one domain.
CORS_ORIGINS=http://localhost,http://localhost:3001,http://localhost:3000

# Database
# Placeholder, not a working credential. Substitute your own user and password,
# and use the SAME value in packages/db/.env. Seed connects with that file;
# this suite and the API connect with this one. They must be one database.
# Native local dev: localhost. Inside Docker (compose), the container's
# localhost is itself — use host.docker.internal to reach a host Postgres:
#   DATABASE_URL="postgres://<user>:<password>@host.docker.internal:5432/turbo-template"
DATABASE_URL="postgres://<user>:<password>@localhost:5432/turbo-template"

# Backend e2e signs in as the seeded admin. It reads SEED_ADMIN_PASSWORD from
# packages/db/.env (the seeder's file). Do not copy that password here.
# E2E_ADMIN_PASSWORD is an optional explicit override of the test process.
# E2E_ADMIN_EMAIL overrides the seeded address (default admin@turbo-template.local);
# an email is not a secret.
# E2E_ADMIN_PASSWORD=
# E2E_ADMIN_EMAIL=

# Authentication (Better Auth)
# Trusted origins must include the public origin the browser uses.
# Behind the proxy that is the single Nginx origin (http://localhost).
# NON-FUNCTIONAL PLACEHOLDER — the app refuses to boot with this value.
# Generate a real secret (>= 32 chars) and paste it in:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=<replace-me-run-openssl-rand-base64-32>
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost,http://localhost:3001,http://localhost:3000

# Cookie scope. Leave UNSET unless you deliberately need one session shared
# across subdomains (AC-3 / F-33): unset means a host-only cookie, the narrowest
# option, and any value here widens it to every subdomain of that host. Shipping
# it set — as this file used to — hands that widening to anyone who copies the
# file without reading this far.
# BETTER_AUTH_COOKIE_DOMAIN=example.com

# OAuth Providers (Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis (shared throttle counters + RBAC permission cache)
# Optional. Unset: both stay process-local, which is correct for a single
# instance. Set: a limit of N is N across the whole cluster, and a revoked
# permission dies everywhere at once instead of lingering per instance.
# Degradation if Redis goes away: the RBAC cache fails CLOSED (every read falls
# through to the database — slower, always correct) while the throttler fails
# OPEN (requests allowed, since a rate-limit outage must not become a total
# outage).
# REDIS_URL=redis://:<password>@localhost:6379
REDIS_KEY_PREFIX=turbo-template   # Lets several environments share one Redis

# Rate Limiting (Throttler)
# Two named limiters: "default" (all routes) and "strict" (mutating routes
# decorated with @StrictThrottle()). Counters live in Redis when REDIS_URL is
# set; otherwise in-memory, resetting on restart and counted per instance.
THROTTLE_TTL=60000            # Window in ms for the default limiter
THROTTLE_LIMIT=100            # Max requests per window (default limiter)
THROTTLE_STRICT_TTL=60000     # Window in ms for the strict limiter
THROTTLE_STRICT_LIMIT=10      # Max requests per window (strict limiter)
# Number of trusted proxy hops (1 = single Nginx in front). WARNING: never set
# > 0 if the backend is directly internet-exposed (clients could spoof
# X-Forwarded-For and bypass IP throttling).
TRUST_PROXY=1

# Structured Logging (pino)
LOG_LEVEL=info               # fatal | error | warn | info | debug | trace

# API Docs (Scalar) and the Better Auth openAPI reference
# One rule, shared by the backend and @repo/auth: an explicit
# ENABLE_API_DOCS wins; otherwise docs are on only in development.
# An unset NODE_ENV counts as development. Leave commented out to use
# that default.
# ENABLE_API_DOCS=true

# HTTP Strict Transport Security (ED-1)
# Off by default, and deliberately so: HSTS is a promise the browser remembers.
# Sending it before TLS terminates in front of the app (ED-2) pins clients to
# HTTPS on a deployment that cannot serve it, and `max-age` cannot be withdrawn
# quickly. Turn it on once TLS is live in the target environment.
# ENABLE_HSTS=true

# Error Monitoring (Sentry)
# Off by default. Reporting starts only when BOTH SENTRY_ENABLED=true AND a
# valid SENTRY_DSN are set — a flag with no DSN is an unfinished deployment, a
# DSN with no flag is a value parked for later, and neither is consent to start
# shipping events off the box. With either missing the SDK is never initialised
# and the app behaves exactly as it does today.
# The DSN is a write-only ingest key, not a secret in the credential sense, but
# it still identifies your project — keep the real one out of this file.
# SENTRY_ENABLED=true
# SENTRY_DSN=https://<publicKey>@<org>.ingest.sentry.io/<projectId>
# Groups events in the Sentry UI. Falls back to NODE_ENV when unset, so staging
# and production never merge by accident.
# SENTRY_ENVIRONMENT=staging
# Performance tracing sample rate, 0..1. Defaults to 0 (errors only) because
# traces consume quota fast; the health check is always excluded regardless.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# IMAGE_TAG is set by the deploy workflow and reported as the Sentry release —
# nothing to configure locally.

# Transactional Email (SMTP / Mailer)
# Leave SMTP_HOST unset to use the dev console transport (emails printed to
# stdout, no real mail server needed). Set it to use a real SMTP transport.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587                # Standard submission port
# SMTP_USER=<your-smtp-username>
# SMTP_PASS=<your-smtp-password>
SMTP_SECURE=false            # true for port 465 (TLS), false for STARTTLS
# Quote the WHOLE value. `"Dev Mailer" <no-reply@localhost>` quotes only the
# display name: dotenv tolerates it, but Compose reads the closing quote and
# then treats ` <no-reply@localhost>` as a new variable name, so `env_file`
# fails and the backend container will not start at all.
MAIL_FROM="Dev Mailer <no-reply@localhost>"
APP_WEB_URL=http://localhost:3001   # Base URL for email links

# Email Verification
EMAIL_VERIFICATION_ENABLED=true     # Send verification emails on signup
EMAIL_VERIFICATION_REQUIRED=true    # Refuse sign-in until the address is verified (PRD decision)

# Auth Rate Limiting (Better Auth built-in)
AUTH_RATE_LIMIT_WINDOW=60     # Window in seconds
AUTH_RATE_LIMIT_MAX=10        # Max auth requests per window
