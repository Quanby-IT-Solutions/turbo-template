{
	"name": "@repo/backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"dev": "nest start --watch",
		"format": "prettier --check \"src/**/*.ts\"",
		"format:fix": "prettier --write \"src/**/*.ts\"",
		"start": "node dist/main.js",
		"lint": "eslint --flag unstable_native_nodejs_ts_config \"src/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"verify:telemetry": "tsx test/telemetry-modes.ts",
		"test:e2e": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config ./test/jest-e2e.json --runInBand",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nest-lab/throttler-storage-redis": "^1.2.0",
		"@nestjs/common": "catalog:",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "catalog:",
		"@nestjs/graphql": "^13.4.5",
		"@nestjs/microservices": "^11.2.7",
		"@nestjs/platform-express": "^11.2.7",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^11.4.7",
		"@nestjs/terminus": "^11.0.0",
		"@nestjs/throttler": "^6.4.0",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/core": "2.10.0",
		"@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.221.0",
		"@opentelemetry/instrumentation": "0.221.0",
		"@opentelemetry/instrumentation-express": "0.69.0",
		"@opentelemetry/instrumentation-http": "0.221.0",
		"@opentelemetry/instrumentation-ioredis": "0.69.0",
		"@opentelemetry/instrumentation-nestjs-core": "0.67.0",
		"@opentelemetry/instrumentation-pg": "0.73.0",
		"@opentelemetry/instrumentation-pino": "0.67.0",
		"@opentelemetry/resources": "2.10.0",
		"@opentelemetry/sdk-metrics": "2.10.0",
		"@opentelemetry/sdk-trace-base": "2.10.0",
		"@opentelemetry/sdk-trace-node": "2.10.0",
		"@orpc/contract": "catalog:",
		"@orpc/nest": "catalog:",
		"@orpc/openapi": "^1.15.7",
		"@orpc/server": "^1.15.7",
		"@orpc/zod": "^1.15.7",
		"@repo/auth": "workspace:*",
		"@repo/contracts": "workspace:*",
		"@repo/db": "workspace:*",
		"@repo/observability": "workspace:*",
		"@scalar/nestjs-api-reference": "1.0.17",
		"@sentry/nestjs": "catalog:",
		"@sentry/opentelemetry": "10.70.0",
		"@t3-oss/env-core": "catalog:",
		"@thallesp/nestjs-better-auth": "2.5.4",
		"better-auth": "catalog:",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"ioredis": "^6.0.0",
		"lru-cache": "^11.0.0",
		"nestjs-pino": "^4.6.1",
		"nestjs-zod": "^5.1.1",
		"pg": "catalog:",
		"pino-http": "^11.0.0",
		"posthog-node": "^5.61.2",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@jest/globals": "^30.5.2",
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.0.9",
		"@nestjs/testing": "^11.2.7",
		"@repo/eslint-config": "workspace:*",
		"@repo/prettier-config": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.11.0",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@types/supertest": "^6.0.3",
		"chokidar": "^5",
		"cross-env": "^10.1.0",
		"eslint": "catalog:",
		"jest": "^30.5.2",
		"pino-pretty": "^13.1.3",
		"prettier": "catalog:",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.6",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"prettier": "@repo/prettier-config",
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.spec.json"
				}
			]
		},
		"transformIgnorePatterns": [
			"node_modules/(?!.pnpm/(@t3-oss\\+env-core|@t3-oss\\+env-nextjs)|@t3-oss/env-core)"
		],
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"coverageThreshold": {
			"global": {
				"lines": 25,
				"functions": 20,
				"branches": 20,
				"statements": 25
			}
		},
		"coveragePathIgnorePatterns": [
			"<rootDir>/modules/v1/examples/"
		],
		"testEnvironment": "node",
		"moduleNameMapper": {
			"^@repo/db/(.*)$": "<rootDir>/../../../packages/db/src/$1",
			"^@repo/auth/(.*)$": "<rootDir>/../../../packages/auth/src/$1",
			"^@repo/contracts$": "<rootDir>/../../../packages/contracts/src",
			"^@repo/observability$": "<rootDir>/../../../packages/observability/src/index.ts",
			"^@/(.*)$": "<rootDir>/$1",
			"^(\\.{1,2}/.*)\\.js$": "$1"
		},
		"setupFiles": [
			"<rootDir>/../jest.setup.ts"
		]
	}
}
