# ==========================================================
# MOBILE CONFIGURATION — NOT BUNDLED INTO THE APP
# ==========================================================
# WARNING: this file is NOT read at runtime and is NOT shipped in the APK.
# It used to be declared as a Flutter asset, which packaged it inside every
# build in cleartext (MB-2 / F-42).
#
# Configuration is compiled in with --dart-define instead:
#
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3000/api
#   flutter build apk --release #     --dart-define=API_BASE_URL=https://api.example.com/api #     --dart-define=API_VERSION=v1
#
# Release builds REFUSE to start without API_BASE_URL and require https://,
# because the release manifest denies cleartext traffic.
#
# Never put a secret in a --dart-define either: compiled-in values are still
# recoverable from the binary. Secrets belong on the server.
# ==========================================================

# ==========================================================
# MOBILE APP ENVIRONMENT VARIABLES
# ==========================================================

# API base URL
# Android emulator: http://10.0.2.2:3000/api
# Physical device: use your machine's LAN IP, for example http://192.168.x.x:3000/api
API_BASE_URL=http://10.0.2.2:3000/api

# Backend API version
API_VERSION=v1