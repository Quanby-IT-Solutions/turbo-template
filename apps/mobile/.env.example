# ==========================================================
# MOBILE APP ENVIRONMENT VARIABLES — NOT BUNDLED INTO THE APP
# ==========================================================
# WARNING: this file is NOT read at runtime and is NOT shipped in the APK.
# It used to be declared as a Flutter asset, which packaged it inside every
# build in cleartext (MB-2 / F-42).
#
# It is kept only as a record of the values a build needs. Configuration is
# compiled in with --dart-define instead:
#
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3000/api
#
#   flutter build apk --release \
#     --dart-define=API_BASE_URL=https://api.example.com/api \
#     --dart-define=API_VERSION=v1
#
# Release builds REFUSE to start without API_BASE_URL and require https://,
# because the release manifest denies cleartext traffic.
#
# Never put a secret in a --dart-define either: compiled-in values are still
# recoverable from the binary. Secrets belong on the server.
# ==========================================================

# API base URL
# Android emulator: http://10.0.2.2:3000/api
# Physical device: use your machine's LAN IP, for example http://192.168.x.x:3000/api
API_BASE_URL=http://10.0.2.2:3000/api

# Backend API version
API_VERSION=v1

# ----------------------------------------------------------
# Crash reporting (Sentry) — --dart-define only, same as above
# ----------------------------------------------------------
# Omit all three and the app builds exactly as it did before Sentry existed:
# the SDK is never initialised, no observer is installed, no network call is
# made. Both SENTRY_ENABLED=true AND a non-empty SENTRY_DSN are required to
# turn it on; either alone is treated as "off".
#
#   flutter build apk --release \
#     --dart-define=SENTRY_ENABLED=true \
#     --dart-define=SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project> \
#     --dart-define=SENTRY_ENVIRONMENT=production
#
# The DSN is a write credential for the project's event stream. It is never
# logged, printed, or interpolated into a message anywhere in the app.

# Master switch for crash reporting (default: false)
SENTRY_ENABLED=false

# Ingest DSN — leave empty to keep crash reporting off
SENTRY_DSN=

# Deployment tag attached to every event (default: development)
SENTRY_ENVIRONMENT=development
