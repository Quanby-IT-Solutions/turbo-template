<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        MB-2 / F-24: cleartext HTTP is permitted in DEBUG BUILDS ONLY.

        `usesCleartextTraffic="true"` used to sit in the main manifest, which
        applies to release too, so production traffic could travel in plaintext.
        The main manifest now denies cleartext; this debug-only override restores
        it so local development against an HTTP backend still works.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
