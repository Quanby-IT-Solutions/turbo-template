# ==========================================================
# WEB APP ENVIRONMENT VARIABLES
# ==========================================================

# Server Configuration
NODE_ENV=development

# Server-only internal API URL (optional, useful in Docker/container networks)
# INTERNAL_API_BASE_URL=http://backend:3000/api

# Public URLs
# Defaults target non-Docker local dev (web :3001, backend :3000).
# For the single-port Nginx proxy (docker compose), use one origin instead
# (these are set in the ROOT .env, which feeds the web image build args):
#   NEXT_PUBLIC_APP_URL=http://localhost
#   NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_VERSION=v1

# Sentry crash reporting
# OFF by default. Both the flag AND a DSN are required before anything is sent
# — a flag on its own is treated as a misconfiguration, not as consent to
# report somewhere. Leave every line commented out to build and run without a
# Sentry account.
#
# Server + edge runtimes:
# SENTRY_ENABLED=true
# SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
# Optional; falls back to NODE_ENV. Set it when the build mode and the
# deployment do not agree (a production build running in staging).
# SENTRY_ENVIRONMENT=staging
#
# Browser runtime (inlined into the client bundle at build time):
# NEXT_PUBLIC_SENTRY_ENABLED=true
# NEXT_PUBLIC_SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
# Optional. Only needed to override SENTRY_ENVIRONMENT for the browser: when it
# is unset, the build projects SENTRY_ENVIRONMENT onto it so client, server and
# edge events all carry the same environment.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
# Probability between 0 and 1, shared by all runtimes. 0 (the default) means
# errors only, no tracing.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
#
# Source-map upload (CI only, never committed and never NEXT_PUBLIC_*).
# SENTRY_AUTH_TOKEN is a write credential for the Sentry org; without it the
# bundler plugin skips upload entirely, which is the default here.
# SENTRY_ORG=<org-slug>
# SENTRY_PROJECT=<project-slug>
# SENTRY_AUTH_TOKEN=<sentry-auth-token>

# Note: email verification and password-reset links (verify-email,
# reset-password) are built from APP_WEB_URL in the auth package
# (packages/auth). APP_WEB_URL is a BACKEND-side env var set in
# apps/backend/.env — it is not a NEXT_PUBLIC_* web variable.
