# ==========================================================
# WEB APP ENVIRONMENT VARIABLES
# ==========================================================

# Server Configuration
NODE_ENV=development

# Server-only internal API URL (optional, useful in Docker/container networks)
# INTERNAL_API_BASE_URL=http://backend:3000/api

# Public URLs
# Defaults target non-Docker local dev (web :3001, backend :3000).
# For the single-port Nginx proxy (docker compose), use one origin instead
# (these are set in the ROOT .env, which feeds the web image build args):
#   NEXT_PUBLIC_APP_URL=http://localhost
#   NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_VERSION=v1

# Note: email verification and password-reset links (verify-email,
# reset-password) are built from APP_WEB_URL in the auth package
# (packages/auth). APP_WEB_URL is a BACKEND-side env var set in
# apps/backend/.env — it is not a NEXT_PUBLIC_* web variable.
