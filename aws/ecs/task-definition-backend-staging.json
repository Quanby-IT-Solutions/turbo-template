{
	"family": "${PROJECT_NAME}-backend-staging",
	"networkMode": "awsvpc",
	"requiresCompatibilities": ["FARGATE"],
	"cpu": "256",
	"memory": "512",
	"executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}-ecs-execution-role-staging",
	"taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}-ecs-execution-role-staging",
	"containerDefinitions": [
		{
			"name": "backend",
			"image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${PROJECT_NAME}-backend-staging:${IMAGE_TAG:-latest}",
			"portMappings": [
				{
					"containerPort": 3000,
					"protocol": "tcp"
				}
			],
			"essential": true,
			"environment": [
				{
					"name": "NODE_ENV",
					"value": "production"
				},
				{
					"name": "PORT",
					"value": "3000"
				},
				{
					"name": "CORS_ORIGINS",
					"value": "${CORS_ORIGINS}"
				},
				{
					"name": "DATABASE_URL",
					"value": "${DATABASE_URL}"
				},
				{
					"name": "BETTER_AUTH_SECRET",
					"value": "${BETTER_AUTH_SECRET}"
				},
				{
					"name": "BETTER_AUTH_TRUSTED_ORIGINS",
					"value": "${BETTER_AUTH_TRUSTED_ORIGINS}"
				},
				{
					"name": "BETTER_AUTH_COOKIE_DOMAIN",
					"value": "${BETTER_AUTH_COOKIE_DOMAIN}"
				},
				{
					"name": "GOOGLE_CLIENT_ID",
					"value": "${GOOGLE_CLIENT_ID}"
				},
				{
					"name": "GOOGLE_CLIENT_SECRET",
					"value": "${GOOGLE_CLIENT_SECRET}"
				}
			],
			"logConfiguration": {
				"logDriver": "awslogs",
				"options": {
					"awslogs-group": "/ecs/${PROJECT_NAME}-backend-staging",
					"awslogs-region": "${AWS_REGION}",
					"awslogs-stream-prefix": "ecs",
					"awslogs-create-group": "true"
				}
			},
			"healthCheck": {
				"command": [
					"CMD-SHELL",
					"wget --no-verbose --tries=1 --spider http://localhost:3000/api/v1/health || exit 1"
				],
				"interval": 30,
				"timeout": 10,
				"retries": 3,
				"startPeriod": 40
			}
		}
	],
	"tags": [
		{
			"key": "Name",
			"value": "${PROJECT_NAME}-backend-staging"
		},
		{
			"key": "Environment",
			"value": "staging"
		}
	]
}
