# ==========================================================
# DATABASE PACKAGE ENVIRONMENT VARIABLES
# ==========================================================

# Database Connection
# Placeholder, not a working credential: a real `postgres:password` pair checked
# in here is what secret scanners flag, and what an adopter copies verbatim into
# an environment that is not local. Substitute your own.
# Use the SAME value in apps/backend/.env. `pnpm db:seed` connects with this
# file; backend e2e boots with apps/backend/.env. They must be one database.
DATABASE_URL="postgres://<user>:<password>@localhost:5432/turbo-template"

# ==========================================================
# SEEDING (`pnpm db:seed`) — development only
# ==========================================================
# The seeder provisions a pre-verified Admin account. It refuses to run when
# NODE_ENV=production, or when DATABASE_URL does not point at a local host.

# Password for the seeded accounts. Set this once, in THIS file only. Backend
# e2e reads the same variable from the same file — do not copy it into
# apps/backend/.env. `E2E_ADMIN_PASSWORD` is an optional per-run override of
# the test process, not a second stored password.
# Leave unset only when you do not need a known password: the seeder generates
# a random one and prints it exactly once, and backend e2e then refuses to
# start (there is no default). A value set here is used as-is and is never
# printed.
# SEED_ADMIN_PASSWORD=

# Deliberate opt-in for seeding a disposable, NON-production remote database.
# Never set this against production — NODE_ENV=production refuses regardless.
# ALLOW_REMOTE_SEED=true

# Re-runs preserve existing seed passwords. To rotate them, pass the flag
# (needed when backend e2e should sign in and the stored password was random
# or differs from SEED_ADMIN_PASSWORD):
#   pnpm db:seed -- --force-password

# ==========================================================
# WEB E2E USERS (`pnpm db:seed:e2e`) — development only
# ==========================================================
# Upserts two pre-verified ordinary users (no role) for Playwright.
# The same production and non-local guards as `pnpm db:seed` apply.
# Passwords are required, have no default, and are never printed.
# Re-runs keep an existing password unless you pass --force-password.
# Emails are optional; unset uses the Playwright fixture defaults
# (test@gmail.com and e2e-user-b@turbo-template.local).
# E2E_TEST_EMAIL=
# E2E_TEST_NAME=
# E2E_TEST_EMAIL_B=
# E2E_TEST_PASSWORD=
# E2E_TEST_PASSWORD_B=
