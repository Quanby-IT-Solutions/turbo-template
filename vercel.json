{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "cd ../.. && pnpm turbo run build --filter=@repo/web --filter=@repo/backend",
	"installCommand": "cd ../.. && pnpm install --frozen-lockfile",
	"outputDirectory": ".next",
	"framework": "nextjs",
	"functions": {
		"api/index.ts": {
			"memory": 1024,
			"maxDuration": 10
		}
	},
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "/api"
		}
	],
	"git": {
		"deploymentEnabled": true
	}
}
